# Environment Configuration Template
# Copy this file to .env.local for development or .env.production for production
# Replace all placeholder values with your actual configuration

# Supabase Configuration (Required)
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Configuration
REACT_APP_ENVIRONMENT=development
REACT_APP_API_BASE_URL=http://localhost:3000/api
REACT_APP_APP_NAME=Payslip Generator
REACT_APP_VERSION=1.0.0

# Security Configuration (Optional)
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_SENTRY_DSN=

# CDN Configuration (Production Only)
REACT_APP_CDN_URL=
REACT_APP_STATIC_URL=

# Database Configuration (Backend Services)
DATABASE_URL=postgresql://username:password@localhost:5432/payslip_db
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,xlsx,xls,csv

# Session Configuration
SESSION_SECRET=your-secure-session-secret-key-min-32-chars
JWT_SECRET=your-jwt-secret-key-min-32-chars

# Logging
LOG_LEVEL=debug
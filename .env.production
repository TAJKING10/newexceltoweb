# Production Environment Configuration for OVHcloud
# Replace these values with your actual OVHcloud configuration

# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Configuration
REACT_APP_ENVIRONMENT=production
REACT_APP_API_BASE_URL=https://your-domain.com/api
REACT_APP_APP_NAME=Payslip Generator
REACT_APP_VERSION=1.0.0

# Security Configuration
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_SENTRY_DSN=your-sentry-dsn-if-using

# OVHcloud Specific
REACT_APP_CDN_URL=https://your-cdn-url.com
REACT_APP_STATIC_URL=https://your-static-assets-url.com

# Database Configuration (for backend services)
DATABASE_URL=postgresql://username:password@your-db-host:5432/payslip_db
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Configuration (if using email features)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,xlsx,xls,csv

# Session Configuration
SESSION_SECRET=your-secure-session-secret-key
JWT_SECRET=your-jwt-secret-key

# Logging
LOG_LEVEL=info